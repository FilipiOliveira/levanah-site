---
import { navigation, whatsappURL } from '../data/site';
---
<footer class="site-footer"><div class="container">
  <div class="footer-grid"><div><a class="brand" href="#inicio" aria-label="Levanah Tech — voltar ao início"><span class="brand-name">LEVANAH</span><span class="brand-detail">TECH</span></a><p>Soluções tecnológicas que começam<br />com a compreensão do seu desafio.</p></div>
  <nav aria-label="Navegação do rodapé"><ul>{navigation.map(item => <li><a href={item.href}>{item.label}</a></li>)}</ul></nav>
  <div class="footer-contact"><span>Vamos conversar</span><a href={whatsappURL} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp da Levanah Tech: +55 (19) 98239-2167 (abre em nova aba)">+55 (19) 98239-2167 ↗</a><small>WhatsApp comercial</small></div></div>
  <div class="footer-bottom"><span>© {new Date().getFullYear()} Levanah Tech</span><a href="#inicio">Voltar ao início ↑</a></div>
</div></footer>
<style>
  .site-footer { border-top: 1px solid var(--color-border); padding-block: 3.5rem 1.5rem; }
  a { text-decoration: underline; text-decoration-color: transparent; text-underline-offset: .35em; transition: color var(--motion-fast) ease, text-decoration-color var(--motion-fast) ease; }
  a:focus-visible { color: var(--color-gold); text-decoration-color: currentColor; }
  @media (hover: hover) and (pointer: fine) { a:hover { color: var(--color-gold); text-decoration-color: currentColor; } }
  .footer-grid { display: grid; grid-template-columns: 1.5fr 1fr 1fr; gap: 2rem; }
  p, small { color: var(--color-muted); font-size: .875rem; }
  ul { list-style: none; margin: 0; padding: 0; }
  li a, .footer-contact a { display: inline-flex; align-items: center; min-height: 44px; }
  li a:hover, .footer-bottom a:hover { color: var(--color-gold); }
  .footer-contact { display: flex; flex-direction: column; align-items: flex-start; }
  .footer-contact > span { color: var(--color-muted); font-size: .875rem; }
  .footer-contact a { color: var(--color-gold); }
  .footer-bottom { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; border-top: 1px solid var(--color-border); margin-top: 2.5rem; padding-top: 1rem; font-size: .8125rem; color: var(--color-muted); }
  .footer-bottom a { display: inline-flex; align-items: center; min-height: 44px; }
  @media (max-width: 768px) { .footer-grid { grid-template-columns: 1fr 1fr; } .footer-grid > :first-child { grid-column: 1 / -1; } }
  @media (max-width: 480px) { .footer-grid { grid-template-columns: 1fr; } }
</style>
