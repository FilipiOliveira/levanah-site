---
import { navigation } from '../data/site';
import ContactLink from './ContactLink.astro';
---
<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="brand" href="#inicio" aria-label="Levanah Tech — início"><span class="brand-name">LEVANAH</span><span class="brand-detail">TECH</span></a>
    <nav class="desktop-navigation" aria-label="Navegação principal"><ul>{navigation.map(item => <li><a data-section-link href={item.href}>{item.label}</a></li>)}</ul></nav>
    <ContactLink class="header-cta" />
    <details class="mobile-menu">
      <summary>Menu <span aria-hidden="true">☰</span></summary>
      <nav aria-label="Navegação mobile"><ul>{navigation.map(item => <li><a data-section-link href={item.href}>{item.label}</a></li>)}</ul><ContactLink /></nav>
    </details>
  </div>
</header>
<style>
  .site-header { position: fixed; top: 0; left: 0; width: 100%; z-index: 20; background: rgb(8 15 23 / 90%); border-bottom: 1px solid transparent; transition: background-color var(--motion-fast) ease, border-color var(--motion-fast) ease; }
  .site-header[data-scrolled], .site-header:has(.mobile-menu[open]) { background: rgb(8 15 23 / 98%); border-bottom-color: var(--color-border); }
  .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding-block: 1.75rem; }
  ul { display: flex; gap: clamp(1rem, 2vw, 2rem); margin: 0; padding: 0; list-style: none; }
  nav a:not(.challenge-cta) { position: relative; display: flex; align-items: center; min-height: 48px; font-size: .875rem; font-weight: 500; transition: color var(--motion-fast) ease; }
  [data-section-link]::after { content: ''; position: absolute; left: 0; right: 0; bottom: 5px; height: 2px; background: var(--color-gold); transform: scaleX(0); transform-origin: left; transition: transform var(--motion-fast) var(--motion-ease); }
  [data-section-link][aria-current], [data-section-link]:focus-visible { color: var(--color-gold); }
  [data-section-link][aria-current]::after, [data-section-link]:focus-visible::after { transform: scaleX(1); }
  @media (hover: hover) and (pointer: fine) { [data-section-link]:hover { color: var(--color-gold); } [data-section-link]:hover::after { transform: scaleX(1); } }
  .header-cta { font-size: .8125rem; white-space: nowrap; }
  .mobile-menu { display: none; }
  @media (max-width: 1100px) {
    .desktop-navigation, .header-cta { display: none; }
    .mobile-menu { display: block; }
    summary { display: flex; align-items: center; gap: .75rem; min-height: 48px; padding: .5rem .75rem; border: 1px solid var(--color-border); border-radius: .35rem; cursor: pointer; list-style: none; transition: background-color var(--motion-fast) ease, border-color var(--motion-fast) ease; }
    summary:focus-visible, .mobile-menu[open] summary { border-color: var(--color-blue); background: var(--color-surface); }
    summary::-webkit-details-marker { display: none; }
    .mobile-menu nav { position: absolute; top: 100%; left: 0; right: 0; margin-inline: 1.5rem; padding: 1.25rem; max-height: calc(100dvh - var(--header-height) - 16px); overflow-y: auto; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: .5rem; box-shadow: 0 16px 40px rgb(0 0 0 / 35%); }
    ul { flex-direction: column; gap: .25rem; }
    .mobile-menu :global(.challenge-cta) { margin-top: 1rem; width: 100%; }
  }
  @media (max-width: 480px) { .header-inner { padding-block: 1.25rem; } .mobile-menu nav { margin-inline: 1rem; } }
</style>
