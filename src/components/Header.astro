---
const plannedPages = ['Soluções', 'Projetos', 'Sobre'];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Levanah Tech — início">
      <span class="brand-name">LEVANAH</span>
      <span class="brand-detail">TECH</span>
    </a>

    <nav aria-label="Navegação principal">
      <ul class="navigation">
        <li><a class="current-page" href="/" aria-current="page">Início</a></li>
        {plannedPages.map((label) => (
          <li>
            <!-- Destinos previstos para a V1; adicionar links apenas quando as páginas existirem. -->
            <span class="planned-page">{label}<small>Em breve</small></span>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-contact">
      <!-- TODO: substituir por um link quando o canal de contato definitivo for configurado. -->
      <button class="challenge-cta header-cta" type="button" disabled aria-describedby="header-contact-status">
        Conte seu desafio
      </button>
      <span id="header-contact-status" class="contact-status">Contato em breve</span>
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 1.5rem;
  }

  .brand {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    min-height: 48px;
    line-height: 1.2;
  }

  .brand-name {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: 0.18em;
  }

  .brand-detail {
    margin-top: 0.35rem;
    color: var(--color-muted);
    font-size: 0.625rem;
    letter-spacing: 0.4em;
  }

  .navigation {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
  }

  .current-page {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    border-bottom: 1px solid var(--color-blue);
    transition: color 180ms ease, text-shadow 180ms ease;
  }

  .current-page:hover {
    color: var(--color-blue);
    text-shadow: 0 0 16px rgb(119 182 239 / 25%);
  }

  .planned-page {
    display: flex;
    flex-direction: column;
    color: var(--color-muted);
  }

  .planned-page small {
    font-size: 0.625rem;
  }

  .header-contact {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }

  .header-cta {
    background: transparent;
    color: var(--color-gold);
    font-size: 0.8125rem;
  }

  .contact-status {
    color: var(--color-muted);
    font-size: 0.6875rem;
  }

  @media (max-width: 900px) {
    .header-inner {
      flex-wrap: wrap;
      gap: 1.25rem;
    }

    nav {
      order: 3;
      width: 100%;
      border-top: 1px solid var(--color-border);
      padding-top: 0.75rem;
    }

    .navigation {
      justify-content: space-between;
    }
  }

  @media (max-width: 640px) {
    .navigation {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.5rem 1rem;
      font-size: 1rem;
    }

    .current-page,
    .planned-page {
      min-height: 52px;
      padding: 0.5rem 0.75rem;
      overflow-wrap: anywhere;
    }

    .current-page {
      width: 100%;
    }

    .planned-page {
      justify-content: center;
    }

    .planned-page small {
      font-size: 0.75rem;
    }
  }

  @media (max-width: 480px) {
    .header-inner {
      padding-block: 1rem;
      gap: 1rem;
    }

    .brand-name {
      font-size: 1rem;
    }

    .header-contact {
      display: none;
    }

  }
</style>
